{
  "version": "1.0",
  "templates": {
    "loop": {
      "for_loop": "for (int i = 0; i < {limit}; i++) {\n    // {action}\n}",
      "while_loop": "while ({condition}) {\n    // {action}\n}",
      "foreach_loop": "for ({type} {item} : {collection}) {\n    // {action}\n}"
    },
    "condition": {
      "if_else": "if ({condition}) {\n    // {true_branch}\n} else {\n    // {false_branch}\n}",
      "if_elseif_else": "if ({condition1}) {\n    // {branch1}\n} else if ({condition2}) {\n    // {branch2}\n} else {\n    // {branch3}\n}",
      "switch_case": "switch ({variable}) {\n    case {value1}:\n        // {action1}\n        break;\n    default:\n        // {default_action}\n}"
    },
    "function": {
      "basic": "{access} {returnType} {methodName}({params}) {\n    // {body}\n    return {returnValue};\n}",
      "static": "{access} static {returnType} {methodName}({params}) {\n    // {body}\n    return {returnValue};\n}"
    },
    "class": {
      "basic": "public class {ClassName} {\n    private {type} {field};\n\n    public {ClassName}({params}) {\n        // {constructor_body}\n    }\n\n    {methods}\n}"
    },
    "io": {
      "java_scanner": "Scanner sc = new Scanner(System.in);\n{type} {var} = sc.next{Type}();",
      "python_input": "{var} = input(\"{prompt}\")",
      "cpp_cin": "cin >> {var};"
    }
  }
}
